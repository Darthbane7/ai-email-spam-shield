# ============================================================================
# 1. GOOGLE OAUTH 2.0 CREDENTIALS (Free via Google Cloud Console)
#    https://console.cloud.google.com/apis/credentials
# ============================================================================
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Optional: Explicitly set your Vercel URL in production (auto-detected if omitted)
# PUBLIC_BASE_URL=https://your-project-name.vercel.app

# Secret key for signing stateless session cookies
SESSION_SECRET=change-this-to-a-random-secret-string

# ============================================================================
# 2. FREE CLOUD DATABASE FOR VERCEL MULTI-USER STORAGE (Upstash Redis Free Tier)
#    https://upstash.com (100% Free, no credit card required)
#    If omitted, falls back automatically to local SQLite (data/saas_users.db)
# ============================================================================
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional secret to protect /api/cron/scan-all if using cron-job.org
CRON_SECRET=
